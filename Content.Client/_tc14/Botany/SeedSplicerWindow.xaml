<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      xmlns:graphics="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
                      Title="{Loc 'seedsplicer-ui-name'}"
                      SetSize="300 300"
                      MinSize="300 300">
    <BoxContainer Orientation="Vertical"
                  SeparationOverride="5"
                  Margin="5 5 5 5">
        <BoxContainer Orientation="Horizontal"
                      SeparationOverride="5"
                      Align="Center"
                      HorizontalExpand="True">
            <PanelContainer HorizontalExpand="True">
                <PanelContainer.PanelOverride>
                    <graphics:StyleBoxFlat BackgroundColor="#1B1B1E" />
                </PanelContainer.PanelOverride>
                <BoxContainer Orientation="Vertical"
                              Margin="5 5 5 5"
                              SeparationOverride="5">
                    <SpriteView Name="SeedOneSpriteView" Scale="2 2"/>
                    <Label Text="???" Name="SeedOneName"/>
                    <Button Name="SeedOneSlotButton" Access="Public"/>
                </BoxContainer>
            </PanelContainer>
            <PanelContainer HorizontalExpand="True">
                <PanelContainer.PanelOverride>
                    <graphics:StyleBoxFlat BackgroundColor="#1B1B1E" />
                </PanelContainer.PanelOverride>
                <BoxContainer Orientation="Vertical"
                              Margin="5 5 5 5"
                              SeparationOverride="5">
                    <SpriteView Name="SeedTwoSpriteView" Scale="2 2"/>
                    <Label Text="???" Name="SeedTwoName"/>
                    <Button Name="SeedTwoSlotButton" Access="Public"/>
                </BoxContainer>
            </PanelContainer>
        </BoxContainer>
        <BoxContainer Align="Center">
            <Button Name="SpliceButton"
                    Access="Public"
                    Text="{Loc 'seedsplicer-ui-splice'}"/>
        </BoxContainer>
        <PanelContainer MinWidth="50"/>
        <PanelContainer>
            <PanelContainer.PanelOverride>
                <graphics:StyleBoxFlat BackgroundColor="#1B1B1E" />
            </PanelContainer.PanelOverride>
            <BoxContainer Orientation="Horizontal"
                          Margin="5 5 5 5"
                          SeparationOverride="5"
                          Align="Center">
                <SpriteView Name="ResultSeedSpriteView" Scale="2 2"/>
                <Label Text="???" Name="ResultSeedName"/>
            </BoxContainer>
        </PanelContainer>
        <PanelContainer MinWidth="50"/>
    </BoxContainer>
</controls:FancyWindow>
